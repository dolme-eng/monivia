# ================================================================
# MONIVIA — Variabili d'ambiente
# Copia questo file in .env e compila i valori
# Su Vercel: aggiungi queste variabili in Settings > Environment Variables
# ================================================================

# --- Vercel KV (Redis) per il Rate Limiting ---
KV_URL="redis://..."
KV_REST_API_URL="https://..."
KV_REST_API_TOKEN="..."

# --- Email SMTP Hostinger ---
# Da configurare dopo l'acquisto di contatto@monivia.it su Hostinger
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="contatto@monivia.it"
SMTP_PASS="la_tua_password_hostinger"

# --- CSRF / Auth ---
# Genera un secret: openssl rand -base64 48
CSRF_SECRET=""
NEXTAUTH_SECRET=""

# --- Google Analytics ---
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# --- URL del sito ---
NEXT_PUBLIC_SITE_URL="https://www.monivia.it"
