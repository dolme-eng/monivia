generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model LoanRequest {
  id              String   @id @default(uuid())
  practiceId      String   @unique
  nome            String
  cognome         String
  codiceFiscale   String
  email           String
  telefono        String
  impiego         String
  reddito         Float
  finalita        String?
  anzianita       Int?
  importo         Float
  durata          Int
  privacy         Boolean
  crif            Boolean
  sourcePage      String?
  createdAt       DateTime @default(now())
}

model ContactMessage {
  id          String   @id @default(uuid())
  nome        String
  email       String
  oggetto     String
  message     String
  sourcePage  String?
  createdAt   DateTime @default(now())
}
