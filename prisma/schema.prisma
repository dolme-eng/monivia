generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model LoanApplication {
  id            String    @id @default(uuid())
  practiceId    String    @unique
  importo       Int
  durata        Int
  impiego       String
  nome          String
  cognome       String
  email         String
  telefono      String
  codiceFiscale String
  reddito       Int
  finalita      String
  anzianita     Int
  sourcePage    String    @default("/")
  status        LoanStatus @default(PENDING)
  notes         String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([practiceId])
}

enum LoanStatus {
  PENDING
  REVIEWED
  APPROVED
  REJECTED
  CONTACTED
}

model ContactMessage {
  id         String   @id @default(uuid())
  nome       String
  email      String
  oggetto    String
  message    String
  sourcePage String   @default("/contatti")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

model AuditLog {
  id         String   @id @default(uuid())
  entity     String
  entityId   String
  action     String
  details    String?
  adminEmail String
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
