generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model LoanApplication {
  id            String    @id @default(uuid())
  practiceId    String    @unique
  importo       Int
  durata        Int
  impiego       String
  nome          String
  cognome       String
  email         String
  telefono      String
  codiceFiscale String
  reddito       Int
  finalita      String
  anzianita     Int
  sourcePage    String    @default("/")
  status        LoanStatus @default(PENDING)
  notes         String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([practiceId])
}

enum LoanStatus {
  PENDING
  REVIEWED
  APPROVED
  REJECTED
  CONTACTED
}
